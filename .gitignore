# Local installation metadata
.codex-auto-retry-release.json

# Keep only the distributable runtime binary in scripts/bin
scripts/bin/*
!scripts/bin/codex-auto-resume.exe

# Local and editor artifacts
*.tmp
.DS_Store
Thumbs.db

# Throwaway scripts and test binaries
.scratch/

# Doc exports and other loose working files
tmp/

# Absolute-path mirror leaked by test binaries run with a different cwd
scripts/source/e/

# Ad-hoc build artifacts left by `go build` inside the module
scripts/source/codex-auto-retry
scripts/source/codex-auto-retry.exe

# Desktop client: frontend bundle staged for //go:embed (built by desktop/build.ps1)
desktop/frontend/dist/*
!desktop/frontend/dist/.keep

# Desktop client build outputs and generated Wails JS bindings
desktop/codex-auto-resume-desktop*
desktop/build/bin/
desktop/wailsjs/

# Generated Windows resource object (desktop/gen-resources.ps1)
desktop/*.syso
