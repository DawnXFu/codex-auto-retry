          "visibility": [
            "model",
            "app"
          ]
        },
        "ui/resourceUri": "ui://codex-auto-retry/management-panel"
      }
    },
    {
      "name": "set_auto_retry_paused",
      "title": "暂停或恢复自动重试",
      "description": "暂停或恢复新的自动重试；已开始的 Codex 任务不会被强制终止。",
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "title": "暂停或恢复自动重试"
      },
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "paused": {
            "description": "true to pause new retry dispatches, false to resume them",
            "type": "boolean"
          }
        },
        "required": [
          "paused"
        ],
        "type": "object"
      },
      "_meta": {
        "openai/outputTemplate": "ui://codex-auto-retry/management-panel",
        "openai/widgetAccessible": true,
        "ui": {
          "resourceUri": "ui://codex-auto-retry/management-panel",
          "visibility": [
            "model",
            "app"
          ]
        },
        "ui/resourceUri": "ui://codex-auto-retry/management-panel"
      }
    },
    {
      "name": "set_retry_prompt",
      "title": "修改后备重试文字",
      "description": "修改静默续接不受支持时使用的后备文字；正常情况下不会新增可见消息，目标模式仍使用原生恢复。",
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "title": "修改重试文字"
      },
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "prompt": {
            "description": "fallback text used only when silent continuation is unsupported, from 1 to 500 characters",
            "type": "string"
          }
        },
        "required": [
          "prompt"
        ],
        "type": "object"
      },
      "_meta": {
        "openai/outputTemplate": "ui://codex-auto-retry/management-panel",
        "openai/widgetAccessible": true,
        "ui": {
          "resourceUri": "ui://codex-auto-retry/management-panel",
          "visibility": [
            "model",
            "app"
          ]
        },
        "ui/resourceUri": "ui://codex-auto-retry/management-panel"
      }
    },
    {
      "name": "set_retry_settings",
      "title": "修改自动重试设置",
      "description": "同时修改后备重试文字、连续无进展重试上限、单次故障恢复上限、固定、翻倍或线性等待策略，以及插件达到上限时的通知设置。",
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "title": "修改自动重试设置"
      },
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "auth_max_attempts": {
            "description": "additional ceiling for authentication errors, from 1 to 1000; omit to preserve the current value; both global limits still apply",
            "type": [
              "null",
              "integer"
            ]
          },
          "delay_increment_seconds": {
            "description": "seconds added after each linear retry, from 1 to 3600 seconds",
            "type": "integer"
          },
          "delay_strategy": {
            "description": "fixed for a constant delay, exponential for doubling delays, or linear for a fixed increase each retry",
            "type": "string"
          },
          "initial_delay_seconds": {
            "description": "fixed delay or first increasing delay, from 1 to 3600 seconds",
            "type": "integer"
          },
          "max_consecutive_retries": {
            "description": "maximum retries without visible assistant progress, from 1 to 100",
            "type": "integer"
          },
          "max_delay_seconds": {
            "description": "maximum increasing delay, from 1 to 86400 seconds",
            "type": "integer"
          },
          "max_recovery_attempts": {
            "description": "maximum attempts in one fault recovery cycle, from 1 to 1000",
            "type": "integer"
          },
          "memory_limit_mb": {
            "description": "private memory limit for the watchdog process, from 128 to 65536 MB; omit to keep the current value",
            "type": [
              "null",
              "integer"
            ]
          },
          "retry_prompt": {
            "description": "fallback text used only when silent continuation is unsupported, from 1 to 500 characters",
            "type": "string"
          },
          "show_notifications": {
            "description": "whether Windows retry notifications are enabled",
            "type": "boolean"
          }
        },
        "required": [
          "retry_prompt",
          "max_consecutive_retries",
          "max_recovery_attempts",
          "initial_delay_seconds",
          "max_delay_seconds",
          "delay_increment_seconds",
          "delay_strategy",
          "show_notifications"
        ],
        "type": "object"
      },
      "_meta": {
        "openai/outputTemplate": "ui://codex-auto-retry/management-panel",
        "openai/widgetAccessible": true,
        "ui": {
          "resourceUri": "ui://codex-auto-retry/management-panel",
          "visibility": [
            "model",
            "app"
          ]
        },
        "ui/resourceUri": "ui://codex-auto-retry/management-panel"
      }
    },
    {
      "name": "set_shared_app_server_enabled",
      "title": "启用或关闭共享后台",
      "description": "显式启用或关闭可选的共享 Codex 后台。启用前会检查回环端口、WebSocket 握手、可执行文件和进程归属；失败时不会修改 Codex 环境。",
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "title": "共享后台模式"
      },
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "description": "true only after the optional shared Codex app-server passes its ownership and health checks",
            "type": "boolean"
          }
        },
        "required": [
          "enabled"
        ],
        "type": "object"
      },
      "_meta": {
        "openai/outputTemplate": "ui://codex-auto-retry/management-panel",
        "openai/widgetAccessible": true,
        "ui": {
          "resourceUri": "ui://codex-auto-retry/management-panel",
          "visibility": [
            "model",
            "app"
          ]
        },
        "ui/resourceUri": "ui://codex-auto-retry/management-panel"
      }
    }
  ],
