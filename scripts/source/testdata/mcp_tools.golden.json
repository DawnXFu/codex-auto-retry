        "openWorldHint": false,
        "title": "取消等待中的重试"
      },
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "thread_id": {
            "description": "Codex task identifier from the current retry queue",
            "type": "string"
          }
        },
        "required": [
          "thread_id"
        ],
        "type": "object"
      },
      "_meta": {
        "openai/outputTemplate": "ui://codex-auto-retry/management-panel",
